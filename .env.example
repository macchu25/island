DATABASE_URL=postgresql://chemimon:chemimon@localhost:5433/chemimon_dev
# api bind address and port (main.ts refuses a PORT outside 1..65535)
HOST=127.0.0.1
PORT=3101
BREEDING_TIME_SCALE=1
EXTRACTOR_COOLDOWN_SCALE=1
# 0 = reviewed rules only (default). 1 = also load unreviewed data/drafts/reactions.yaml (content review only).
CONTENT_INCLUDE_DRAFTS=0
# web: target of the Vite /api proxy (dev and preview)
CHEMIMON_API_URL=http://127.0.0.1:3101
# e2e: 1 turns the perf soft check into a hard assertion (use on a machine with a GPU)
PERF_STRICT=0
