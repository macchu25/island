generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpeditionStatus {
  running
  collected

  @@map("expedition_status")
}

enum BreedingStatus {
  running
  collected

  @@map("breeding_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String   @unique @map("display_name")
  passwordHash String   @map("password_hash")
  /// Xu balance. DB CHECK users_coins_check (coins >= 0), added by hand in migration coins_ledger.
  coins        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions         Session[]
  playerMonsters   PlayerMonster[]
  breedingSessions BreedingSession[]
  discoveries      PlayerDiscovery[]
  firstDiscoveries FirstDiscovery[]
  extractorState   ExtractorState?
  coinLedger       CoinLedger[]
  expeditions      Expedition[]
  permits          PlayerPermit[]
  marketOrders     MarketOrder[]
  blueprints       PlayerBlueprint[]
  products         PlayerProduct[]
  workshopJobs     WorkshopJob[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Chemical {
  id           String @id
  formula      String
  name         String
  kind         String
  atomicNumber Int?   @map("atomic_number")
  group        Int?
  period       Int?
  phaseAt25c   String @map("phase_at_25c")
  family       String

  monster         Monster?
  expeditions     Expedition[]
  reactionInputs  ReactionInput[]
  reactionOutputs ReactionOutput[]
  playerMonsters  PlayerMonster[]
  discoveries     PlayerDiscovery[]
  firstDiscovery  FirstDiscovery?

  @@map("chemicals")
}

model Monster {
  id          String   @id
  chemicalId  String   @unique @map("chemical_id")
  displayName String   @map("display_name")
  rarity      String
  silhouette  String
  color       String
  assetKey    String   @map("asset_key")
  blurb       String
  chemical    Chemical @relation(fields: [chemicalId], references: [id])

  @@map("monsters")
}

model Reaction {
  id         String  @id
  priority   Float
  durationS  Float   @map("duration_s")
  conditions Json
  ratio      Json?
  source     String
  reviewed   Boolean

  inputs           ReactionInput[]
  outputs          ReactionOutput[]
  breedingSessions BreedingSession[]

  @@map("reactions")
}

model ReactionInput {
  reactionId  String   @map("reaction_id")
  chemicalId  String   @map("chemical_id")
  coefficient Int
  reaction    Reaction @relation(fields: [reactionId], references: [id], onDelete: Cascade)
  chemical    Chemical @relation(fields: [chemicalId], references: [id])

  @@id([reactionId, chemicalId])
  @@map("reaction_inputs")
}

model ReactionOutput {
  reactionId  String   @map("reaction_id")
  chemicalId  String   @map("chemical_id")
  coefficient Int
  reaction    Reaction @relation(fields: [reactionId], references: [id], onDelete: Cascade)
  chemical    Chemical @relation(fields: [chemicalId], references: [id])

  @@id([reactionId, chemicalId])
  @@map("reaction_outputs")
}

model PlayerMonster {
  playerId   String   @map("player_id") @db.Uuid
  chemicalId String   @map("chemical_id")
  count      Int
  player     User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  chemical   Chemical @relation(fields: [chemicalId], references: [id])

  @@id([playerId, chemicalId])
  @@map("player_monsters")
}

model BreedingSession {
  id             String         @id @default(uuid()) @db.Uuid
  playerId       String         @map("player_id") @db.Uuid
  inputs         Json
  conditions     Json
  status         BreedingStatus
  result         Json
  collectOutcome Json?          @map("collect_outcome")
  reactionId     String?        @map("reaction_id")
  startedAt      DateTime       @map("started_at") @db.Timestamptz(3)
  readyAt        DateTime       @map("ready_at") @db.Timestamptz(3)
  fee            Int            @default(0)
  player         User           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  reaction       Reaction?      @relation(fields: [reactionId], references: [id], onDelete: SetNull)

  @@index([playerId, status])
  @@map("breeding_sessions")
}

model PlayerDiscovery {
  playerId     String    @map("player_id") @db.Uuid
  chemicalId   String    @map("chemical_id")
  discoveredAt DateTime  @default(now()) @map("discovered_at") @db.Timestamptz(3)
  /// First source ever: starter | extractor | expedition | breeding. DB CHECK player_discoveries_source_check.
  source       String    @default("breeding")
  /// First time breeding produced it (elements too). Quests that count compounds use this.
  bredAt       DateTime? @map("bred_at") @db.Timestamptz(3)
  player       User      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  chemical     Chemical  @relation(fields: [chemicalId], references: [id])

  @@id([playerId, chemicalId])
  @@map("player_discoveries")
}

model Expedition {
  id                String           @id @default(uuid()) @db.Uuid
  playerId          String           @map("player_id") @db.Uuid
  placeId           String           @map("place_id")
  monsterChemicalId String           @map("monster_chemical_id")
  status            ExpeditionStatus
  startedAt         DateTime         @map("started_at") @db.Timestamptz(3)
  readyAt           DateTime         @map("ready_at") @db.Timestamptz(3)
  result            Json
  collectOutcome    Json?            @map("collect_outcome")
  player            User             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  monster           Chemical         @relation(fields: [monsterChemicalId], references: [id])

  @@index([playerId, status])
  @@map("expeditions")
}

model PlayerPermit {
  playerId String   @map("player_id") @db.Uuid
  placeId  String   @map("place_id")
  boughtAt DateTime @default(now()) @map("bought_at") @db.Timestamptz(3)
  player   User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, placeId])
  @@map("player_permits")
}

/// One market order of one stall. The item (chemical_id or product_id), count and reward are a snapshot of the
/// template at open time. Hand-added in migration market_orders: CHECK market_orders_status_check
/// (open | delivered | expired) and the partial unique index market_orders_one_open_per_stall on
/// (player_id, stall_id) WHERE status = 'open'. Hand-added in migration workshop: CHECK market_orders_one_item_check
/// (exactly one of chemical_id and product_id is set).
model MarketOrder {
  id          String    @id @db.Uuid
  playerId    String    @map("player_id") @db.Uuid
  stallId     String    @map("stall_id")
  templateId  String    @map("template_id")
  chemicalId  String?   @map("chemical_id")
  /// A products.yaml id (content, so no foreign key).
  productId   String?   @map("product_id")
  count       Int
  reward      Int
  status      String
  openedAt    DateTime  @map("opened_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  player      User      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, stallId, openedAt])
  @@map("market_orders")
}

/// A bought blueprint. Products with blueprintPrice 0 never get a row: they are known from the start.
model PlayerBlueprint {
  playerId  String   @map("player_id") @db.Uuid
  /// A products.yaml id (content, so no foreign key).
  productId String   @map("product_id")
  boughtAt  DateTime @default(now()) @map("bought_at") @db.Timestamptz(3)
  player    User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, productId])
  @@map("player_blueprints")
}

/// Product stock. Rows at count 0 are kept (selling and delivering decrement to 0).
/// Hand-added in migration workshop: CHECK player_products_count_check (count >= 0).
model PlayerProduct {
  playerId  String @map("player_id") @db.Uuid
  productId String @map("product_id")
  count     Int
  player    User   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, productId])
  @@map("player_products")
}

/// One crafting job: makes one product. Hand-added in migration workshop: CHECK workshop_jobs_status_check
/// (running | collected).
model WorkshopJob {
  id             String    @id @db.Uuid
  playerId       String    @map("player_id") @db.Uuid
  productId      String    @map("product_id")
  status         String
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  readyAt        DateTime  @map("ready_at") @db.Timestamptz(3)
  collectedAt    DateTime? @map("collected_at") @db.Timestamptz(3)
  /// The collect response body, replayed on a second collect.
  collectOutcome Json?     @map("collect_outcome")
  player         User      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
  @@map("workshop_jobs")
}

model FirstDiscovery {
  chemicalId   String   @id @map("chemical_id")
  playerId     String   @map("player_id") @db.Uuid
  discoveredAt DateTime @default(now()) @map("discovered_at") @db.Timestamptz(3)
  chemical     Chemical @relation(fields: [chemicalId], references: [id])
  player       User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("first_discoveries")
}

model ExtractorState {
  playerId    String   @id @map("player_id") @db.Uuid
  lastClaimAt DateTime @map("last_claim_at") @db.Timestamptz(3)
  player      User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("extractor_state")
}

/// Append-only record of every Xu change. Sum of delta per player = users.coins.
model CoinLedger {
  id           String   @id @default(uuid()) @db.Uuid
  playerId     String   @map("player_id") @db.Uuid
  delta        Int
  balanceAfter Int      @map("balance_after")
  reason       String
  refId        String   @map("ref_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  player       User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, reason, refId])
  @@index([playerId, createdAt])
  @@map("coin_ledger")
}
