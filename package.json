{
  "name": "chemimon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:up": "docker compose up -d --no-recreate --wait postgres",
    "db:generate": "pnpm --filter @chemimon/api db:generate",
    "db:migrate": "bash scripts/with-db.sh pnpm --filter @chemimon/api db:migrate",
    "db:seed": "bash scripts/with-db.sh pnpm --filter @chemimon/api db:seed",
    "e2e": "pnpm db:up && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
